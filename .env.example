# UniPulse AI — backend environment template
# Copy to `.env` and fill in the values:
#   cp .env.example .env
#
# Settings are read by app/core/config.py (pydantic-settings).

# --- Required: Groq API key -----------------------------------------------
# Used for LLM structured extraction. Get one at https://console.groq.com
# Enrichment endpoints return HTTP 503 until this is set.
GROQ_API_KEY=

# --- Optional: multi-key sharding / failover -------------------------------
# Comma-separated list of Groq keys. When set, batch uploads are sharded
# across the keys (one shard per key, Semaphore(3) + 0.1s stagger each), and
# every extractor rotates keys with automatic 429 failover — spreading TPM
# usage so 1,000+ row catalogs process without rate-limit crashes.
# Falls back to GROQ_API_KEY when empty.
# GROQ_API_KEYS="gsk_...,gsk_...,gsk_..."
GROQ_API_KEYS=

# --- Optional: alternate LLM providers (reserved) -------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Web-source domain allow-list ------------------------------------------
# When set (JSON array), the scraper only accepts these domains (exclusive).
# When empty, any non-retail domain is allowed by default.
# ALLOWED_DOMAINS=["honeywellhome.com","trane.com"]

# --- CORS -------------------------------------------------------------------
# Origins allowed to call the API. JSON array; "*" for development.
CORS_ORIGINS=["*"]

# --- Frontend (React UI) ----------------------------------------------------
# VITE_API_BASE_URL is read by Vite from `new_frontend/.env`, NOT this file
# (copy new_frontend/.env.example -> new_frontend/.env). It defaults to
# http://127.0.0.1:8000 — only override if the backend runs elsewhere.
# Listed here too so this template documents every required key; the backend
# ignores it (pydantic-settings only reads the keys it knows).
VITE_API_BASE_URL=http://127.0.0.1:8000
