# UniPulse AI — frontend environment template (Vite)
# Copy to `.env` inside new_frontend/:
#   cp .env.example .env
#
# Vite only reads env vars prefixed with VITE_ and only from the frontend
# directory. Loaded by src/services/api.js.

# Backend base URL used for all API calls.
# Defaults to http://127.0.0.1:8000 when unset.
VITE_API_BASE_URL=http://127.0.0.1:8000
